# Configuration Sentry pour le monitoring d'erreurs
# Obtenez votre DSN depuis https://sentry.io/
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Configuration Laravel standard
APP_NAME="Informatique IT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Configuration base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=informatique_it
DB_USERNAME=root
DB_PASSWORD=

# Configuration mail (Amazon SES)
MAIL_MAILER=ses
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@informatique-it.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuration IMAP pour réception d'emails
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_ENCRYPTION=ssl

# Configuration de l'application
BRANDING_NAME="Informatique IT"
BRANDING_DOMAIN="informatique-it.com"
BRANDING_URL="https://informatique-it.com"
BRANDING_PHONE="01 02 03 04 05"
BRANDING_EMAIL="contact@informatique-it.com"

# Configuration cache et session
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Configuration queue
QUEUE_CONNECTION=database